{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CloudGameUserData",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "last_login": {
      "type": "string"
    },
    "playtime_minutes": {
      "type": "number"
    },
    "favorite_games": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "game_saves": {
      "type": "object"
    },
    "settings": {
      "type": "object",
      "properties": {
        "stream_quality": {
          "type": "string"
        },
        "control_mode": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "user_id",
    "username"
  ]
}